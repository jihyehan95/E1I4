#!/usr/bin/env node
// orchestrator: plan → route → schedule → budget → document 를 실제로 순서대로 호출하고,
// flowpilot-data.schema.md 모양의 JSON으로 취합해서 돌려주는 서버.
//
// 사용법: node orchestrator/call-agent --serve [port]   (기본 8788)
// 화면(flowpilot_prototype_dynamic.html)의 "AI 업무 계획 생성" 버튼이
// http://localhost:8788/run 으로 폼 입력을 넘기면, 여기서 5단계를 실행해 결과를 돌려준다.

const fs = require("fs");
const path = require("path");
const os = require("os");
const http = require("http");
const { spawn, execSync } = require("child_process");
const Anthropic = require("@anthropic-ai/sdk");
const { z } = require("zod");
const { betaZodOutputFormat } = require("@anthropic-ai/sdk/helpers/beta/zod");
const AdmZip = require("adm-zip");

// 비용 절감을 위해 전 단계 동일 모델 사용 (opus 대신 sonnet)
const MODEL = "claude-sonnet-5";

const ROOT = path.join(__dirname, "..");
const ENV_PATH = path.join(ROOT, ".env");
const AGENTS_DIR = path.join(ROOT, ".claude", "agents");
const STAGE_CACHE_PATH = path.join(os.tmpdir(), "orchestrator-stage-cache.json");

// 화면(정적 파일) 서빙 허용목록 — 요청 경로 → 저장소 루트 기준 파일. "/"는 랜딩페이지가 먼저 뜨게 한다.
const STATIC_FILES = {
  "/": "ddalkkak_ai_landing.html",
  "/index.html": "ddalkkak_ai_landing.html",
  "/ddalkkak_ai_landing.html": "ddalkkak_ai_landing.html",
  "/딸깍 서비스.html": "딸깍 서비스.html",
  "/로고.jpg": "로고.jpg",
  "/flowpilot-data.js": "flowpilot-data.js",
};
const STATIC_CONTENT_TYPES = {
  ".html": "text/html; charset=utf-8",
  ".js": "text/javascript; charset=utf-8",
  ".jpg": "image/jpeg",
  ".png": "image/png",
};

function readEnvFile(envPath) {
  if (!fs.existsSync(envPath)) return {};
  const env = {};
  for (const line of fs.readFileSync(envPath, "utf8").split("\n")) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith("#")) continue;
    const eq = trimmed.indexOf("=");
    if (eq === -1) continue;
    env[trimmed.slice(0, eq).trim()] = trimmed.slice(eq + 1).trim();
  }
  return env;
}

// Render 등 배포 환경은 .env 파일 대신 process.env로 값을 주입하므로, process.env를 먼저 보고
// 없으면(로컬 개발용) .env 파일을 본다.
function readApiKeyFromEnvFile(envPath) {
  if (process.env.ANTHROPIC_API_KEY) return process.env.ANTHROPIC_API_KEY;
  if (!fs.existsSync(envPath)) {
    throw new Error(`ANTHROPIC_API_KEY가 환경변수에 없고, .env 파일도 찾을 수 없습니다: ${envPath}`);
  }
  const value = readEnvFile(envPath).ANTHROPIC_API_KEY;
  if (!value) throw new Error("ANTHROPIC_API_KEY가 환경변수에도, .env 파일에도 없습니다.");
  return value;
}

// 조직에 SSO 등으로 여러 워크스페이스가 있으면 콘솔에서 API 키를 "identity-linked"로 발급하는
// 경우가 있는데, 이 키는 요청마다 어느 워크스페이스로 동작할지 anthropic-workspace-id 헤더로
// 알려줘야 한다(안 주면 400 invalid_request_error). 일반 워크스페이스 전용 키는 필요 없다.
function readWorkspaceId(envPath) {
  return process.env.ANTHROPIC_WORKSPACE_ID || readEnvFile(envPath).ANTHROPIC_WORKSPACE_ID || "";
}

function createAnthropicClient(apiKey, envPath = ENV_PATH) {
  const workspaceId = readWorkspaceId(envPath);
  return new Anthropic({
    apiKey,
    defaultHeaders: workspaceId ? { "anthropic-workspace-id": workspaceId } : undefined,
  });
}

// USE_LOCAL_CLAUDE=1이면 5단계 파이프라인이 API 키 대신 이 컴퓨터에 로그인된
// claude CLI(Claude 구독)를 호출한다 — 워크스페이스 API 사용량 한도 우회용.
// 배포 서버에는 로그인된 claude CLI가 없으므로 process.env를 우선하고, 없으면 .env 파일을 본다.
function isLocalClaudeEnabled(envPath) {
  const fromEnv = process.env.USE_LOCAL_CLAUDE;
  if (fromEnv !== undefined) return fromEnv.trim() === "1";
  return (readEnvFile(envPath).USE_LOCAL_CLAUDE || "").trim() === "1";
}

// npm 글로벌 설치의 claude.cmd는 내부적으로 같은 폴더의
// node_modules/@anthropic-ai/claude-code/bin/claude.exe 를 실행한다. .cmd를 그대로 spawn하면
// (shell:true 없이는) Windows에서 EINVAL이 나고, shell:true로 돌리면 시스템 프롬프트에 들어있는
// 백틱·파이프 등 특수문자가 이스케이프 없이 cmd.exe로 그대로 넘어가 깨진다. 그래서 .cmd가 가리키는
// .exe를 찾아 shell 없이 직접 spawn한다.
let cachedClaudeExe = null;
function resolveClaudeExe() {
  if (cachedClaudeExe) return cachedClaudeExe;
  if (process.platform !== "win32") {
    cachedClaudeExe = "claude";
    return cachedClaudeExe;
  }
  let cmdPath;
  try {
    cmdPath = execSync("where claude.cmd", { encoding: "utf8" }).split(/\r?\n/)[0].trim();
  } catch {
    throw new Error("로컬 claude CLI(claude.cmd)를 PATH에서 찾지 못했습니다. Claude Code가 설치·로그인되어 있는지 확인해 주세요.");
  }
  const exe = path.join(path.dirname(cmdPath), "node_modules", "@anthropic-ai", "claude-code", "bin", "claude.exe");
  if (!fs.existsSync(exe)) {
    throw new Error(`claude.exe를 찾지 못했습니다: ${exe}`);
  }
  cachedClaudeExe = exe;
  return cachedClaudeExe;
}

// 로컬 claude CLI를 한 번 호출한다(print 모드, 세션 저장 없음, 도구/MCP/슬래시커맨드 전부 꺼서
// 불필요한 컨텍스트·비용을 줄인다). jsonSchema를 주면 --json-schema로 구조화 출력을 강제한다.
// effort를 안 주면 CLI 기본값(높은 편)이 적용돼 단순 작업도 필요 이상으로 오래 생각한다 —
// 호출부에서 작업 성격에 맞게 낮춰서 속도를 확보한다.
function runLocalClaude({ systemPrompt, userText, jsonSchema, effort }) {
  const exe = resolveClaudeExe();
  return new Promise((resolve, reject) => {
    const args = [
      "-p",
      "--model", MODEL,
      "--system-prompt", systemPrompt,
      "--output-format", "json",
      "--no-session-persistence",
      "--tools", "",
      "--disable-slash-commands",
      "--strict-mcp-config",
      "--setting-sources", "",
    ];
    if (jsonSchema) args.push("--json-schema", JSON.stringify(jsonSchema));
    if (effort) args.push("--effort", effort);

    const child = spawn(exe, args, { windowsHide: true });
    let out = "";
    let err = "";
    child.stdout.on("data", (d) => (out += d));
    child.stderr.on("data", (d) => (err += d));
    child.on("error", (e) => reject(new Error(`로컬 claude CLI 실행 실패: ${e.message}`)));
    child.on("close", (code) => {
      if (code !== 0) {
        reject(new Error(`로컬 claude CLI 종료 코드 ${code}: ${(err || out).trim().slice(0, 500)}`));
        return;
      }
      let parsed;
      try {
        parsed = JSON.parse(out);
      } catch (e) {
        reject(new Error(`로컬 claude CLI 응답 파싱 실패: ${e.message}`));
        return;
      }
      if (parsed.is_error) {
        reject(new Error(`로컬 claude CLI 오류: ${parsed.result || "알 수 없는 오류"}`));
        return;
      }
      resolve(parsed);
    });
    child.stdin.write(userText);
    child.stdin.end();
  });
}

// 지도(Naver Maps JS SDK)용 클라이언트 ID는 화면에 노출돼도 되는 값(NCP 콘솔에서 도메인으로
// 제한). Directions/Geocoding REST 호출에 쓰는 시크릿은 절대 브라우저로 보내지 않고 서버(여기)에만
// 둔다. 둘 다 없으면(.env에 안 채워졌으면) 지도·실측 거리 기능은 조용히 꺼지고 기존처럼 추정으로
// 동작한다 — 오늘 범위는 로컬 데모이므로 키가 없어도 파이프라인 자체는 막지 않는다.
function readNaverCredentials(envPath) {
  const env = readEnvFile(envPath);
  const clientId = process.env.NAVER_MAP_CLIENT_ID || env.NAVER_MAP_CLIENT_ID || "";
  const clientSecret = process.env.NAVER_MAP_CLIENT_SECRET || env.NAVER_MAP_CLIENT_SECRET || "";
  return clientId && clientSecret ? { clientId, clientSecret } : null;
}

// ---- Naver Geocoding / Directions (call-agent 네이버 연동) ----
// REST API는 NCP 콘솔에서 발급받은 클라이언트 ID/시크릿을 헤더로 실어 호출한다.
// 시크릿은 이 서버 프로세스 밖으로 절대 나가지 않는다(화면은 /api/geocode 프록시만 호출).

const NAVER_MAPS_BASE = "https://maps.apigw.ntruss.com";

function naverHeaders(creds) {
  return {
    "x-ncp-apigw-api-key-id": creds.clientId,
    "x-ncp-apigw-api-key": creds.clientSecret,
  };
}

// 주소/장소명 → 좌표 1건. plan/route 단계에 "실측 좌표"로 미리 채워주는 용도라 가장 정확도
// 높은 첫 후보만 쓴다. 실패하면(키 없음·네트워크 오류·후보 없음) null을 돌려주고, 호출한
// 쪽에서 그대로 "추정"으로 넘어가게 한다 — 지도·실측 거리는 있으면 좋은 보강이지 필수 경로가 아니다.
async function naverGeocode(creds, query) {
  if (!creds || !query || !query.trim()) return null;
  try {
    const url = `${NAVER_MAPS_BASE}/map-geocode/v2/geocode?query=${encodeURIComponent(query.trim())}`;
    const res = await fetch(url, { headers: naverHeaders(creds) });
    if (res.ok) {
      const body = await res.json();
      const addr = (body.addresses || [])[0];
      if (addr) {
        return {
          lat: Number(addr.y),
          lng: Number(addr.x),
          roadAddress: addr.roadAddress || addr.jibunAddress || query.trim(),
        };
      }
    }
  } catch {}
  // 네이버 Geocoding은 정확한 주소만 인식해 장소명(POI)이 섞인 질의는 0건이 흔하다 — 그럴 때만
  // 무료 Nominatim으로 보강한다(첫 후보만 사용, 검색 자동완성의 폴백과 동일한 원리).
  const fallback = (await nominatimCandidates(query.trim()))[0];
  if (!fallback) return null;
  return { lat: Number(fallback.lat), lng: Number(fallback.lon), roadAddress: fallback.display_name || query.trim() };
}

// 화면 장소 검색 자동완성(옛 Nominatim 대체)용 — 후보 여러 개를 그대로 돌려준다.
async function naverGeocodeCandidates(creds, query) {
  if (!creds || !query || !query.trim()) return [];
  try {
    const url = `${NAVER_MAPS_BASE}/map-geocode/v2/geocode?query=${encodeURIComponent(query.trim())}`;
    const res = await fetch(url, { headers: naverHeaders(creds) });
    if (!res.ok) return [];
    const body = await res.json();
    return (body.addresses || []).slice(0, 5).map((a) => ({
      lat: Number(a.y),
      lon: Number(a.x),
      display_name: a.roadAddress || a.jibunAddress || a.englishAddress || query.trim(),
    }));
  } catch {
    return [];
  }
}

// 네이버 Geocoding은 정확한 주소만 인식하고 "부산대학교" 같은 장소명(POI)은 대부분 못 찾는다.
// 화면 자동완성만큼은 장소명도 잘 찾아주던 옛 Nominatim(무료)으로 보강한다 — 최종 좌표 확정은
// 여전히 geocodeFormVisits()가 사용자가 고른 주소로 네이버 Geocoding을 다시 호출해서 한다.
async function nominatimCandidates(query) {
  try {
    const url = `https://nominatim.openstreetmap.org/search?format=json&limit=5&accept-language=ko&q=${encodeURIComponent(query)}`;
    const res = await fetch(url, { headers: { "User-Agent": "ddalkkak-service/1.0" } });
    if (!res.ok) return [];
    const body = await res.json();
    return Array.isArray(body) ? body : [];
  } catch {
    return [];
  }
}

// 두 좌표 사이의 실측 자동차 이동 거리·시간 (Directions 15 — 경유지 없는 2점 호출).
async function naverDrivingLeg(creds, from, to) {
  if (!creds || !from || !to) return null;
  try {
    const qs = new URLSearchParams({ start: `${from.lng},${from.lat}`, goal: `${to.lng},${to.lat}` });
    const url = `${NAVER_MAPS_BASE}/map-direction-15/v1/driving?${qs.toString()}`;
    const res = await fetch(url, { headers: naverHeaders(creds) });
    if (!res.ok) return null;
    const body = await res.json();
    const route = (body.route?.traoptimal || body.route?.trafast || [])[0];
    if (!route?.summary) return null;
    return {
      distanceKm: route.summary.distance / 1000,
      durationMin: Math.round(route.summary.duration / 60000),
    };
  } catch {
    return null;
  }
}

// 방문 순서(좌표가 있는 지점들)를 받아 구간별 실측 거리·시간을 순서대로 구한다.
// 좌표가 없는 지점(geocoding 실패)이 끼어 있으면 그 앞뒤 구간만 건너뛴다(부분 실측도 의미 있음).
async function naverSequentialLegs(creds, points) {
  const legs = [];
  for (let i = 1; i < points.length; i += 1) {
    const from = points[i - 1];
    const to = points[i];
    if (!from?.lat || !to?.lat) {
      legs.push(null);
      continue;
    }
    legs.push(await naverDrivingLeg(creds, from, to));
  }
  return legs;
}

// 화면 방문 목록(textarea#visits)의 한 줄 형식은 "이름 - 주소 (날짜 시간) [할 일: .., 체류시간: ..]".
// geocoding 질의어로는 주소가 있으면 주소를, 없으면 이름을 쓴다.
function parseVisitLine(line) {
  let rest = line.trim();
  rest = rest.replace(/\s*\[[^\]]*\]\s*$/, "");
  rest = rest.replace(/\s*\([^)]*\)\s*$/, "");
  const dashIdx = rest.indexOf(" - ");
  const name = dashIdx === -1 ? rest.trim() : rest.slice(0, dashIdx).trim();
  const address = dashIdx === -1 ? "" : rest.slice(dashIdx + 3).trim();
  return { name: name || rest, query: address || name || rest };
}

// 기본양식 방문 목록(form.visits)을 실제로 geocoding해 plan/route 단계에 "실측 좌표"로 미리
// 채워준다. 자사양식엔 구조화된 방문 목록이 없어 건너뛴다. 키가 없거나 호출이 실패해도 조용히
// 빈 값을 돌려주고, 각 에이전트는 원래대로(지시문에 있는) 추정 경로로 동작한다.
async function geocodeFormVisits(creds, form) {
  if (!creds || form.customForm || !form.visits || !form.visits.trim()) {
    return { coordsText: "", legsText: "", points: [] };
  }
  const lines = form.visits.split("\n").map((l) => l.trim()).filter(Boolean);
  const parsed = lines.map(parseVisitLine);

  const points = [];
  for (const p of parsed) {
    const geo = await naverGeocode(creds, p.query);
    points.push({ name: p.name, ...geo });
  }

  const coordsText = points
    .map((p) =>
      p.lat != null
        ? `- ${p.name}: ${p.roadAddress} (위도 ${p.lat.toFixed(6)}, 경도 ${p.lng.toFixed(6)})`
        : `- ${p.name}: 좌표 확인 실패 — 추정 필요`,
    )
    .join("\n");

  const legs = await naverSequentialLegs(creds, points);
  const legsText = legs
    .map((leg, i) =>
      leg
        ? `- ${points[i].name} → ${points[i + 1].name}: 실측 약 ${leg.distanceKm.toFixed(1)}km, ${leg.durationMin}분(자동차)`
        : `- ${points[i].name} → ${points[i + 1].name}: 실측 불가 — 추정 필요`,
    )
    .join("\n");

  return { coordsText, legsText, points };
}

// 이름으로 geocoding 결과와 아이템(방문지/숙소)을 대응시킨다. route 에이전트가 위치명을
// 살짝 바꿔 쓸 수 있어 완전 일치가 아니면 부분 포함으로도 맞춰본다. 좌표는 우리가 직접 호출한
// Naver Geocoding 응답값을 그대로 붙이는 것이라 LLM이 옮겨적는 과정에서 생기는 오타·환각 위험이 없다.
function matchGeocodedPoint(points, name) {
  const norm = (s) => (s || "").replace(/\s+/g, "").toLowerCase();
  const target = norm(name);
  if (!target) return null;
  return (
    points.find((p) => p.lat != null && norm(p.name) === target) ||
    points.find((p) => p.lat != null && (target.includes(norm(p.name)) || norm(p.name).includes(target))) ||
    null
  );
}

// .claude/agents/{name}.md 의 YAML 앞머리를 걷어내고 역할 지시문 본문만 꺼낸다.
function readRoleInstruction(name) {
  const specPath = path.join(AGENTS_DIR, `${name}.md`);
  if (!fs.existsSync(specPath)) {
    throw new Error(`에이전트 지시문 파일을 찾을 수 없습니다: ${specPath}`);
  }
  const raw = fs.readFileSync(specPath, "utf8");
  const parts = raw.split(/^---\s*$/m);
  if (parts.length < 3) {
    throw new Error(`${specPath}에서 역할 지시문 본문을 찾지 못했습니다.`);
  }
  return parts.slice(2).join("---").trim();
}

// 각 단계별로 orchestrator.md/flowpilot-data.schema.md 가 정한 상태값 어휘.
// (해당 .md 파일 자체는 건드리지 않고, 이번 호출에만 지시문 끝에 덧붙인다.)
const STAGE_STATES = {
  plan: ["ok", "request", "reject"],
  route: ["ok", "reject"],
  schedule: ["ok", "warn", "adjust", "fail"],
  budget: ["ok", "fail", "cannot"],
  document: ["ok", "fail"],
};

// 진행을 멈추고 사용자 확인을 받아야 하는 상태 (schema.md 의 orchestrator 동작 열 기준)
// "missing"은 이 파이프라인이 붙이는 별도 상태다: 모델 응답에서 ORCH_STATE 줄을 못 찾았을 때
// (형식을 안 지켰거나 max_tokens로 잘렸을 때) 통과로 처리하지 않고 안전하게 멈추기 위한 것.
const HARD_STOP_STATES = new Set(["reject", "request", "fail", "cannot", "missing"]);

async function callStage(client, agentName, inputText, extraBlocks = [], useLocal = false) {
  const baseInstruction = readRoleInstruction(agentName);
  const allowed = STAGE_STATES[agentName].join(" | ");
  const system =
    baseInstruction +
    `\n\n---\n(orchestrator 자동화용 지시 — 이 저장소의 .claude/agents/${agentName}.md 파일에는 없는, 이번 호출에만 붙이는 지시다)\n` +
    `본문을 쓰기 전에, 맨 첫 줄에 아래 형식으로 한 줄을 먼저 써라. 그 줄 앞에는 아무것도 쓰지 마라. ` +
    `역할대로 판단한 결과(예: 정보가 부족해 반려/요청해야 하는지)를 먼저 정하고 그 값을 이 줄에 쓴 뒤, 이어서 본문을 작성해라.\n` +
    `ORCH_STATE: <${allowed}>`;

  let raw;
  if (useLocal) {
    if (extraBlocks.length) {
      throw new Error(`로컬 claude 모드에서는 "${agentName}" 단계의 이미지/PDF 첨부 입력을 지원하지 않습니다.`);
    }
    // medium: plan/route/budget 등은 실제 판단(반려·초과 여부 등)이 걸려 있어 too-low는
    // 위험하지만, CLI 기본값(높은 편)은 이 정도 작업에 비해 느려서 한 단계 낮춘다.
    const result = await runLocalClaude({ systemPrompt: system, userText: inputText, effort: "medium" });
    raw = result.result || "";
  } else {
    // extraBlocks가 있으면(예: 참고 보고서 형식 PDF/이미지) 텍스트 앞에 붙여서 함께 보낸다
    const content = extraBlocks.length
      ? [...extraBlocks, { type: "text", text: inputText }]
      : inputText;

    const response = await client.messages.create({
      model: MODEL,
      max_tokens: 16000,
      system,
      messages: [{ role: "user", content }],
    });

    raw = response.content
      .filter((b) => b.type === "text")
      .map((b) => b.text)
      .join("\n");
  }

  // 맨 첫 줄(앞의 공백·줄바꿈만 허용)에서만 찾는다 — 본문 중간에 우연히 같은 문구가 나와도 오인하지 않는다.
  const stateRe = new RegExp(`^\\s*ORCH_STATE:\\s*(${STAGE_STATES[agentName].join("|")})\\s*\\n?`, "i");
  const match = raw.match(stateRe);

  if (!match) {
    // 상태 줄이 없으면(형식 위반·응답 잘림 등) 통과로 넘기지 않고 멈춘다.
    return {
      state: "missing",
      text: `⚠ 이 단계 응답에서 ORCH_STATE 줄을 첫 줄에서 찾지 못해, 안전을 위해 통과 처리하지 않고 멈췄습니다. (모델이 형식을 안 지켰거나 응답이 중간에 잘렸을 수 있습니다)\n\n${raw.trim()}`,
    };
  }

  const state = match[1].toLowerCase();
  const text = raw.slice(match[0].length).trim();

  return { state, text };
}

function section(title, body) {
  if (!body) return "";
  return `## ${title}\n\n${body}\n`;
}

// 화면의 "경비 기준 설정" 카드 값(회사 내규상 인당 한도)을 규정 문구로 만든다.
function formatBudgetRule(rule) {
  if (!rule) return "";
  const parts = [];
  if (rule.meal) parts.push(`식비 인당 ${Number(rule.meal).toLocaleString()}원 이내`);
  if (rule.snack) parts.push(`다과비 인당 ${Number(rule.snack).toLocaleString()}원 이내`);
  if (rule.lodging) parts.push(`숙박비 인당 ${Number(rule.lodging).toLocaleString()}원 이내`);
  if (rule.transport) parts.push(`교통비 ${rule.transport}`);
  if (rule.fuelRate) parts.push(`자차 이용 시 유류비 km당 ${Number(rule.fuelRate).toLocaleString()}원`);
  return parts.join(", ");
}

// 사용자가 적은 참고/추가 조건(출발시각·교통편 선호·숙소 검색 기준 등)은 판단에만 쓰라고
// 넘기는 것이지, 최종 문서에 원문 그대로 옮겨 적으라는 뜻이 아니다 — 안 붙이면 에이전트가
// 자기 reason/note에 이 원문을 그대로 인용해 최종 보고서 맨 아래에 그대로 노출되곤 했다.
function conditionsSection(title, text) {
  if (!text) return "";
  return section(
    title,
    `${text}\n\n(※ 이 내용은 계산·판단에만 참고하고, reason·note 등 최종 결과에 노출되는 항목에 이 원문을 그대로 옮기지 마라. 이 내용을 반영한 결과 자체만 표시해라.)`,
  );
}

function buildPlanInput(form) {
  if (form.customForm) {
    // 자사 양식 경로: 표준 필드에 매핑하지 않고, 양식이 요구한 항목을 그대로 전달한다.
    // plan 에이전트가 이미 "항목이 충분한지" 스스로 판단해 부족하면 요청/반려하므로
    // 별도 스키마 매핑 없이도 그대로 동작한다.
    const answers = (form.customFormAnswers || [])
      .filter((a) => a.value && a.value.trim())
      .map((a) => `${a.label}: ${a.value}`)
      .join("\n");
    return [
      section("자사 양식 입력 내용 (사용자가 회사 자체 양식에 채운 값 그대로)", answers),
      section("출장비 규정 (화면 경비 기준 설정값, 그대로 적용)", formatBudgetRule(form.budgetRule)),
      section("추가 설명", form.customFormFreeText),
      section("작성자", form.author),
    ]
      .filter(Boolean)
      .join("\n");
  }

  return [
    section("출장 목적", form.purpose),
    section(
      "일정 (기간, 필수 목적지)",
      `기간: ${form.startDate} ~ ${form.endDate}\n\n방문 대상:\n${form.visits}`,
    ),
    section("인원", `총 ${form.people}명${form.attendees ? `\n참석자: ${form.attendees}` : ""}`),
    section(
      "예산",
      `예산 상한: ${form.budget}원\n지출항목/기관: ${form.projectName} / ${form.taskType}`,
    ),
    section("출장비 규정 (화면 경비 기준 설정값, 그대로 적용)", formatBudgetRule(form.budgetRule)),
    section("call-agent가 사전 확인한 실측 좌표 (Naver Geocoding — 있으면 그대로 쓰고, 없는 지점만 추정)", form._geocodeCoordsText),
    conditionsSection("참고/추가 조건", form.conditions),
    section("작성자", form.author),
  ]
    .filter(Boolean)
    .join("\n");
}

function buildRouteInput(planText, form) {
  const rejection = form.budgetRejection;
  return (
    section("plan 결과 (출장 위치·일정)", planText) +
    section("요청 시간", `방문 가능 기간: ${form.startDate} ~ ${form.endDate}`) +
    section("call-agent가 사전 확인한 실측 좌표 (Naver Geocoding — 있으면 그대로 쓰고, 없는 지점만 추정)", form._geocodeCoordsText) +
    section(
      "입력 순서 기준 구간별 실측 이동거리·시간 (Naver Directions — 방문 순서가 이 구간을 그대로 유지하면 그대로 쓰고, 순서를 바꿔 새로 생긴 구간만 추정)",
      form._geocodeLegsText,
    ) +
    (rejection
      ? section(
          "⚠ 이전 예산 검토 반려 피드백 (이번 후보를 찾을 때 반드시 반영)",
          `이전에 이 route 단계가 찾은 후보로 계산한 "예상 사용 금액"이 예산 상한을 초과해 사람이 반려했다.\n` +
          `반려 사유: "${rejection.reason}"\n` +
          `예산 상한: ${Number(rejection.budgetLimit || 0).toLocaleString()}원, 이전 예상 사용 금액 합계: ${Number(rejection.previousTotal || 0).toLocaleString()}원\n` +
          `이전에 제시했던 후보:\n${rejection.previousCandidates || "(없음)"}\n\n` +
          `이번에는 위 반려 사유와 예산 상한을 반드시 고려해서, 더 저렴하거나 사유에 맞는 대안 후보를 다시 찾아라. ` +
          `같은 후보를 그대로 다시 제시하지 말고, 왜 이번 후보가 더 적정한지 비고에 한 줄로 남겨라. ` +
          `그래도 예산 상한 안에 들어오는 현실적인 대안을 못 찾겠으면 지어내지 말고, 그 사실 그대로("적정 대안 없음" 등) 표시해라.`,
        )
      : "")
  );
}

function buildScheduleInput(routeText, planText) {
  return (
    section("route 결과 (동선 순서)", routeText) +
    section("plan 결과 (방문 가능 시간·체류시간·해야 할 일 참고용)", planText)
  );
}

function buildBudgetInput(scheduleText, planText, routeText, form) {
  return (
    section("schedule 결과 (일정)", scheduleText) +
    section("plan 결과 (출장비 규정·예산 상한)", planText) +
    section("route 결과 (교통편·숙박·식당 후보와 예상 비용 — '예상 사용 금액' 계산에 그대로 쓴다)", routeText) +
    conditionsSection("숙소/교통 관련 참고", form.conditions)
  );
}

function buildDocumentInput(scheduleText, budgetText, planText, budgetApprovedOverride) {
  return (
    section("schedule 결과 (최종 일정)", scheduleText) +
    section("budget 결과 (경비 정보)", budgetText) +
    section("plan 결과 (문서 기본 정보)", planText) +
    (budgetApprovedOverride
      ? section(
          "⚠ 예산 초과 승인 처리",
          "위 budget 결과는 예상 사용 금액이 예산 상한을 초과(예산 초과)로 판정됐으나, " +
          "담당자가 초과분을 승인해 이대로 진행하기로 했다. 문서에 예산 초과 사실과 승인되어 진행됐다는 점을 표시해라.",
        )
      : "")
  );
}

// ---- 취합: 5단계 결과 텍스트 -> flowpilot-data.schema.md 모양 JSON ----

const PersonnelZ = z.object({ org: z.string(), count: z.number(), members: z.string() });
const VisitZ = z.object({
  no: z.number(),
  day: z.number().nullable(),
  type: z.string(),
  name: z.string(),
  address: z.string(),
  moveFromPrev: z.string(),
  arrive: z.string(),
  excluded: z.boolean(),
  excludeReason: z.string(),
});
const ScheduleRowZ = z.object({
  date: z.string(),
  time: z.string(),
  place: z.string(),
  move: z.string(),
  dwell: z.string(),
  work: z.string(),
  state: z.enum(["ok", "warn", "adjust"]),
});
const CostCandidateZ = z.object({
  category: z.string(),
  name: z.string(),
  unit: z.string(),
  unitPrice: z.number(),
  note: z.string(),
});
const BudgetRowZ = z.object({
  name: z.string(),
  ruleAmount: z.number(),
  ruleFormula: z.string(),
  estimatedAmount: z.number(),
  estimatedFormula: z.string(),
});

const StageCommonZ = { state: z.string(), label: z.string(), reason: z.string() };

// 완료된 단계만 넣어서 그때그때 스키마를 만든다 (스키마가 크면 API가 400을 낸다 —
// 5단계를 항상 optional로 다 갖고 있는 큰 스키마 대신, 실제 완료된 단계만 required로 구성).
const STAGE_SHAPE_BUILDERS = {
  plan: () =>
    z.object({
      ...StageCommonZ,
      projectName: z.string(),
      taskType: z.string(),
      region: z.string(),
      period: z.object({ start: z.string(), end: z.string(), nights: z.number(), days: z.number() }),
      purpose: z.string(),
      peopleTotal: z.number(),
      personnel: z.array(PersonnelZ),
      budgetLimit: z.number(),
      expenseCategory: z.string(),
      author: z.string(),
      background: z.string(),
    }),
  route: () => z.object({ ...StageCommonZ, visits: z.array(VisitZ), costCandidates: z.array(CostCandidateZ) }),
  schedule: () => z.object({ ...StageCommonZ, rows: z.array(ScheduleRowZ) }),
  budget: () =>
    z.object({
      ...StageCommonZ,
      rows: z.array(BudgetRowZ),
      ruleTotal: z.number(),
      estimatedTotal: z.number(),
      budgetLimit: z.number(),
    }),
  document: () =>
    z.object({
      state: z.string(),
      label: z.string(),
      title: z.string(),
      author: z.string(),
      createdAt: z.string(),
      hotel: z.string(),
      note: z.string(),
    }),
};

// 단계 하나만 구조화한다. (5단계를 한 번에 큰 스키마로 요청하면 strict 구조화 출력의
// grammar가 너무 커져 API가 400(grammar too large)을 내는 경우가 있어, 단계별로 나눠
// 작고 확실한 스키마로 각각 구조화한다 — 호출 수는 늘지만 각 호출은 매우 작다.)
async function aggregateStage(client, stageName, stageResult, useLocal = false) {
  const ShapeZ = STAGE_SHAPE_BUILDERS[stageName]();

  const system =
    `너는 방금 실행된 출장 파이프라인의 "${stageName}" 단계 결과를 flowpilot-data.schema.md 규격의 JSON으로 구조화하는 담당이다. ` +
    "텍스트에 있는 값만 사용해라. 텍스트에 없는 값은 지어내지 말고, 알 수 없으면 빈 문자열이나 빈 배열로 둬라. " +
    "숫자 필드(peopleTotal, ruleAmount, estimatedAmount, ruleTotal, estimatedTotal, unitPrice, budgetLimit 등)는 콤마를 뺀 순수 숫자로 넣어라. " +
    "budget 단계의 ruleAmount/ruleTotal은 '경비 기준 설정'(인당 한도 규정)으로 계산한 기준금액, estimatedAmount/estimatedTotal은 route 단계가 조사한 실제 후보로 계산한 예상 사용 금액이다 — 서로 다른 계산이니 섞지 마라. " +
    "'(추정)'이라고 표시된 값은 그 표시를 값 문자열에 그대로 남겨서, 실측값과 구분되게 해라. " +
    "reason/note 필드는 반드시 한두 줄 요약만 넣어라 — 사용자가 입력한 참고사항·요청사항 원문을 그대로 옮겨 적지 마라. " +
    "그 내용을 반영한 판단 결과나 이유만 짧게 적어라.";

  const body = `### ${stageName} (state: ${stageResult.state})\n\n${stageResult.text}`;

  let parsedJson;
  if (useLocal) {
    const jsonSchema = z.toJSONSchema(ShapeZ);
    delete jsonSchema.$schema; // claude CLI의 --json-schema는 $schema 키(외부 참조로 오인)를 거부한다
    // 단순 재구조화라 API 경로와 동일하게 low로 — 여기서 higher effort는 속도만 깎아먹는다.
    const result = await runLocalClaude({ systemPrompt: system, userText: body, jsonSchema, effort: "low" });
    if (result.structured_output !== undefined) {
      parsedJson = result.structured_output;
    } else {
      try {
        parsedJson = JSON.parse(result.result);
      } catch (e) {
        throw new Error(`"${stageName}" 취합 JSON 파싱 실패(로컬 claude): ${e.message}`);
      }
    }
  } else {
    // client.beta.messages.create (parse 헬퍼 아님) + 직접 JSON.parse + zod 검증.
    // (설치된 SDK 버전의 .parse() 헬퍼가 신형 output_config.format을 못 알아보고
    //  항상 parsed_output: null을 돌려주는 버그가 있어 우회함 — API 자체는 정상 응답함)
    const response = await client.beta.messages.create({
      model: MODEL,
      max_tokens: 4000,
      system,
      messages: [{ role: "user", content: body }],
      // 단순 재구조화 작업이라 effort를 낮춘다 (기본 high는 과도하게 생각만 하다
      // 답을 못 내놓는 경우가 있었음)
      output_config: { effort: "low", format: betaZodOutputFormat(ShapeZ) },
    });

    const textBlock = response.content.find((b) => b.type === "text");
    if (!textBlock) {
      throw new Error(`"${stageName}" 취합 응답에 텍스트가 없습니다 (stop_reason: ${response.stop_reason}).`);
    }

    try {
      parsedJson = JSON.parse(textBlock.text);
    } catch (e) {
      throw new Error(`"${stageName}" 취합 JSON 파싱 실패: ${e.message}`);
    }
  }

  const result = ShapeZ.safeParse(parsedJson);
  if (!result.success) {
    const debugPath = path.join(os.tmpdir(), `orchestrator-aggregate-debug-${stageName}.json`);
    try { fs.writeFileSync(debugPath, textBlock.text); } catch {}
    throw new Error(
      `"${stageName}" 취합 스키마 검증 실패: ${JSON.stringify(result.error.issues).slice(0, 500)} ` +
      `(원본 응답 전체는 ${debugPath} 에 저장됨)`,
    );
  }
  return result.data;
}

async function aggregate(client, completedStages, useLocal = false) {
  const data = {};
  for (const name of Object.keys(completedStages)) {
    data[name] = await aggregateStage(client, name, completedStages[name], useLocal);
  }
  return data;
}

// ---- 파이프라인 실행 ----

// onEvent({type:"stage_start"|"stage_done", stage, state?}) — 화면의 포켓몬 애니메이션이
// 실제 에이전트 진행 속도에 맞춰 움직일 수 있도록, 각 단계 시작/종료 시점에 실시간으로 알린다.
async function runPipeline(form, onEvent = () => {}) {
  const useLocal = isLocalClaudeEnabled(ENV_PATH);
  const client = useLocal ? null : createAnthropicClient(readApiKeyFromEnvFile(ENV_PATH));
  const naverCreds = readNaverCredentials(ENV_PATH);

  // plan/route를 부르기 전에 방문 목록을 실제로 geocoding해둔다 — route.md가 "받은 실측
  // 좌표·거리가 있으면 그대로 쓴다"는 지시를 따를 수 있게 입력에 실어준다.
  const geocoded = await geocodeFormVisits(naverCreds, form);
  form._geocodeCoordsText = geocoded.coordsText;
  form._geocodeLegsText = geocoded.legsText;

  const completed = {}; // { plan: {state,text}, route: {...}, ... }
  let hardStopped = null;

  onEvent({ type: "stage_start", stage: "plan" });
  const planInput = buildPlanInput(form);
  completed.plan = await callStage(client, "plan", planInput, [], useLocal);
  onEvent({ type: "stage_done", stage: "plan", state: completed.plan.state });
  if (HARD_STOP_STATES.has(completed.plan.state)) {
    hardStopped = { stage: "plan", ...completed.plan };
  }

  if (!hardStopped) {
    onEvent({ type: "stage_start", stage: "route" });
    const routeInput = buildRouteInput(completed.plan.text, form);
    completed.route = await callStage(client, "route", routeInput, [], useLocal);
    onEvent({ type: "stage_done", stage: "route", state: completed.route.state });
    if (HARD_STOP_STATES.has(completed.route.state)) hardStopped = { stage: "route", ...completed.route };
  }

  if (!hardStopped) {
    onEvent({ type: "stage_start", stage: "schedule" });
    const scheduleInput = buildScheduleInput(completed.route.text, completed.plan.text);
    completed.schedule = await callStage(client, "schedule", scheduleInput, [], useLocal);
    onEvent({ type: "stage_done", stage: "schedule", state: completed.schedule.state });
    if (HARD_STOP_STATES.has(completed.schedule.state)) hardStopped = { stage: "schedule", ...completed.schedule };
  }

  // 예산 초과(state: "fail")로 멈춰야 하는 경우라도, 사용자가 이미 초과분을 승인했으면
  // (form.budgetApproved) 하드스톱 없이 document까지 이어서 진행한다. "계산 불가"(cannot)는
  // 승인으로 넘길 수 있는 초과 상황이 아니므로 그대로 멈춘다.
  let budgetApprovedOverride = false;
  if (!hardStopped) {
    onEvent({ type: "stage_start", stage: "budget" });
    const budgetInput = buildBudgetInput(completed.schedule.text, completed.plan.text, completed.route.text, form);
    completed.budget = await callStage(client, "budget", budgetInput, [], useLocal);
    onEvent({ type: "stage_done", stage: "budget", state: completed.budget.state });
    if (HARD_STOP_STATES.has(completed.budget.state)) {
      if (completed.budget.state === "fail" && form.budgetApproved) {
        budgetApprovedOverride = true;
      } else {
        hardStopped = { stage: "budget", ...completed.budget };
      }
    }
  }

  if (!hardStopped) {
    onEvent({ type: "stage_start", stage: "document" });
    const documentInput = buildDocumentInput(
      completed.schedule.text,
      completed.budget.text,
      completed.plan.text,
      budgetApprovedOverride,
    );
    completed.document = await callStage(client, "document", documentInput, [], useLocal);
    onEvent({ type: "stage_done", stage: "document", state: completed.document.state });
    if (HARD_STOP_STATES.has(completed.document.state)) hardStopped = { stage: "document", ...completed.document };
  }

  // 디버깅용: 5단계 실행 결과를 캐시해서, 취합 단계만 다시 테스트할 수 있게 한다
  // (node orchestrator/call-agent --aggregate-from <경로>)
  try {
    fs.writeFileSync(STAGE_CACHE_PATH, JSON.stringify(completed, null, 2));
  } catch {}

  const data = await aggregate(client, completed, useLocal);

  // 지도에 찍을 좌표는 LLM 취합이 아니라 우리가 직접 부른 Naver Geocoding 응답값을 이름으로
  // 매칭해 붙인다(환각·오타 위험 없음). 방문지 목록과 숙소(있으면) 모두 채운다.
  if (data.route?.visits?.length) {
    for (const v of data.route.visits) {
      const match = matchGeocodedPoint(geocoded.points, v.name) || matchGeocodedPoint(geocoded.points, v.address);
      if (match) {
        v.lat = match.lat;
        v.lng = match.lng;
      }
    }
  }
  if (data.document?.hotel) {
    const hotelGeo = await naverGeocode(naverCreds, data.document.hotel);
    if (hotelGeo) {
      data.document.hotelLat = hotelGeo.lat;
      data.document.hotelLng = hotelGeo.lng;
    }
  }

  data.meta = {
    generatedAt: new Date().toISOString().slice(0, 10),
    source: useLocal
      ? "orchestrator (plan→route→schedule→budget→document, 로컬 claude CLI 실행)"
      : "orchestrator (plan→route→schedule→budget→document, 실제 API 실행)",
    note: hardStopped
      ? `${hardStopped.stage} 단계에서 멈춤 — 사용자 확인 필요`
      : budgetApprovedOverride
        ? "5단계 모두 통과 (예산 초과분은 승인 처리됨)"
        : "5단계 모두 통과",
  };

  return { data, hardStopped };
}

function describeError(error) {
  if (error instanceof Anthropic.AuthenticationError) return "인증 실패: ANTHROPIC_API_KEY 값을 확인해 주세요.";
  if (error instanceof Anthropic.RateLimitError) return "요청이 몰렸습니다. 잠시 후 다시 시도해 주세요.";
  if (error instanceof Anthropic.BadRequestError) return `잘못된 요청입니다: ${error.message}`;
  if (error instanceof Anthropic.APIError) return `API 오류 (${error.status}): ${error.message}`;
  return error.message;
}

// ---- 자사 양식 파싱 (시작화면 "자사 양식 넣기") ----

const TemplateFieldZ = z.object({
  id: z.string(),
  label: z.string(),
  hint: z.string(),
  type: z.enum(["text", "textarea", "date", "number"]),
});
// 최종 문서를 업로드한 양식과 같은 모양으로 그리기 위한 "틀" 정보 — 입력 항목(fields)과는 별개다.
// headerLabels: 승인란(담당/팀장/부서장 등 서명칸) 빼고, 기안부서·기안자·출장기간처럼 표로 나열된 메타 항목명.
// sections: 본문에 번호로 나열된 절 제목과, 그 절이 서술형 문단인지(text) 표(table)인지·표라면 열 이름.
// closingText: 맨 끝의 상투 문구(예: "위와 같이 출장을 실시하고자 하오니...") — 없으면 빈 문자열.
const OutlineSectionZ = z.object({
  title: z.string(),
  kind: z.enum(["text", "table"]),
  columns: z.array(z.string()),
});
const TemplateParseZ = z.object({
  fields: z.array(TemplateFieldZ),
  headerLabels: z.array(z.string()),
  sections: z.array(OutlineSectionZ),
  closingText: z.string(),
  confidence: z.enum(["high", "low"]),
  note: z.string(),
});

function stripXmlTags(xml) {
  return xml.replace(/<[^>]+>/g, " ").replace(/&nbsp;/g, " ").replace(/\s+/g, " ").trim();
}

// docx/hwpx는 zip 안에 XML로 본문이 들어있는 형식이라(둘 다 OOXML 계열),
// 압축을 풀어 XML 텍스트만 추출한다. 비용 절감을 위해 길이를 제한한다.
function extractZipDocumentText(base64) {
  const buf = Buffer.from(base64, "base64");
  const zip = new AdmZip(buf);
  const entries = zip.getEntries().filter((e) => /\.xml$/i.test(e.entryName));
  const preferred = entries.filter(
    (e) => /word\/document\.xml$/i.test(e.entryName) || /^Contents\//i.test(e.entryName),
  );
  const picked = preferred.length ? preferred : entries;
  const text = picked.map((e) => stripXmlTags(e.getData().toString("utf8"))).join("\n");
  return text.slice(0, 8000);
}

async function parseTemplate(client, { fileName, mediaType, base64 }) {
  const system =
    "너는 회사 자체 업무/출장 신청 양식(기안문)을 분석해서 두 가지를 뽑아내는 담당이다: " +
    "(A) 사용자가 실제로 입력해야 하는 항목(fields), (B) 완성된 문서의 틀(headerLabels/sections/closingText) — " +
    "이 문서와 똑같은 모양으로 최종 결과물을 다시 그릴 때 쓴다.\n\n" +
    "(A) fields — 입력 항목:\n" +
    "안내문·서명란·직인란·예시 문구는 항목으로 넣지 마라. " +
    "각 항목은 id(영문 소문자·숫자·언더스코어, 문서 내에서 서로 겹치지 않게), label(회사 양식에 실제로 적힌 항목명 그대로), " +
    "hint(입력 예시나 설명, 없으면 빈 문자열), type(text/textarea/date/number 중 하나 — " +
    "날짜는 date, 긴 서술형은 textarea, 금액·인원 등 숫자는 number, 그 외는 text)로 만들어라.\n\n" +
    "(B) 문서 틀:\n" +
    "- headerLabels: 문서 맨 위에 표로 나열된 메타 항목명(예: 기안부서, 기안자, 기안일자, 출장구분, 출장기간, 출장지역, 출장자, 방문처). " +
    "결재란(담당/팀장/부서장 같은 서명·직인용 빈 칸)은 제외해라.\n" +
    "- sections: 본문에 번호(1., 2. 등)로 나열된 절 제목을 그 순서 그대로, 각 절이 서술형 문단(kind: \"text\")인지 " +
    "표(kind: \"table\")인지 판단해서 적어라. 표면 columns에 그 표의 열 이름을 순서대로 적어라(예: 일정 표면 [\"일자\",\"시간\",\"주요 내용\"], " +
    "경비 표면 [\"구분\",\"산출 근거\",\"금액\"]). text면 columns는 빈 배열.\n" +
    "- closingText: 문서 맨 끝의 상투적인 마무리 문구(예: \"위와 같이 출장을 실시하고자 하오니 검토 후 승인하여 주시기 바랍니다.\")를 " +
    "그대로 옮겨 적어라. 없으면 빈 문자열.\n\n" +
    "문서 내용을 읽지 못했거나 항목을 알아볼 수 없으면 fields/headerLabels/sections를 모두 빈 배열로, closingText도 빈 문자열로 하고 " +
    "confidence를 low로, note에 이유를 한 줄로 적어라. 정상적으로 뽑아냈으면 confidence는 high로 하고 note는 빈 문자열로 둬라.";

  const lower = (fileName || "").toLowerCase();
  let content;
  if (mediaType === "application/pdf") {
    content = [
      { type: "document", source: { type: "base64", media_type: "application/pdf", data: base64 } },
      { type: "text", text: "이 문서는 회사 자체 업무 신청 양식이다. 위 지시대로 입력 항목과 문서 틀을 뽑아라." },
    ];
  } else if (mediaType && mediaType.startsWith("image/")) {
    content = [
      { type: "image", source: { type: "base64", media_type: mediaType, data: base64 } },
      { type: "text", text: "이 이미지는 회사 자체 업무 신청 양식이다. 위 지시대로 입력 항목과 문서 틀을 뽑아라." },
    ];
  } else if (lower.endsWith(".docx") || lower.endsWith(".hwpx")) {
    const text = extractZipDocumentText(base64);
    content = text
      ? `다음은 회사 자체 업무 신청 양식(${fileName})에서 추출한 본문 텍스트다. 위 지시대로 입력 항목과 문서 틀을 뽑아라.\n\n${text}`
      : `회사 자체 업무 신청 양식 파일(${fileName})에서 본문을 추출하지 못했다. fields는 빈 배열로, confidence는 low로 답해라.`;
  } else {
    // 구버전 .hwp(바이너리) 등 서버에서 본문 추출이 불가능한 형식 — 파일명만 참고 가능
    content = `업로드된 파일(${fileName}, ${mediaType || "형식 불명"})은 서버에서 본문을 읽지 못하는 형식이다. ` +
      `파일명만 참고 가능하다. fields는 빈 배열로, confidence는 low로, ` +
      `note에 "이 파일 형식은 자동으로 읽을 수 없어요"라고 답해라.`;
  }

  const response = await client.beta.messages.create({
    model: MODEL,
    max_tokens: 4000,
    system,
    messages: [{ role: "user", content }],
    output_config: { effort: "low", format: betaZodOutputFormat(TemplateParseZ) },
  });

  const textBlock = response.content.find((b) => b.type === "text");
  if (!textBlock) {
    throw new Error(`양식 분석 응답에 텍스트가 없습니다 (stop_reason: ${response.stop_reason}).`);
  }

  let parsed;
  try {
    parsed = JSON.parse(textBlock.text);
  } catch (e) {
    throw new Error(`양식 분석 JSON 파싱 실패: ${e.message}`);
  }

  const result = TemplateParseZ.safeParse(parsed);
  if (!result.success) {
    throw new Error(`양식 분석 스키마 검증 실패: ${JSON.stringify(result.error.issues).slice(0, 500)}`);
  }
  return result.data;
}

// ---- 서버 ----

function runServer(port) {
  const server = http.createServer(async (req, res) => {
    res.setHeader("Access-Control-Allow-Origin", "*");
    res.setHeader("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
    res.setHeader("Access-Control-Allow-Headers", "Content-Type");

    if (req.method === "OPTIONS") {
      res.writeHead(204);
      res.end();
      return;
    }

    // 배포(Render 등)에서는 이 서버 하나가 API와 화면(정적 파일)을 같이 서빙한다 — 저장소의
    // 아무 파일이나 열어주면 안 되니(.env, .claude 지시문 등), 실제로 화면에 필요한 파일만
    // 허용목록으로 관리한다. "/" 는 랜딩페이지를 먼저 보여주고, 거기서 서비스 화면으로 넘어간다.
    if (req.method === "GET" && STATIC_FILES[decodeURIComponent(new URL(req.url, "http://localhost").pathname)]) {
      const pathname = decodeURIComponent(new URL(req.url, "http://localhost").pathname);
      const filePath = path.join(ROOT, STATIC_FILES[pathname]);
      fs.readFile(filePath, (err, data) => {
        if (err) {
          res.writeHead(404, { "Content-Type": "text/plain; charset=utf-8" });
          res.end("Not found");
          return;
        }
        const ext = path.extname(filePath);
        res.writeHead(200, { "Content-Type": STATIC_CONTENT_TYPES[ext] || "application/octet-stream" });
        res.end(data);
      });
      return;
    }

    if (req.method === "GET" && req.url.startsWith("/config")) {
      // 지도(Naver Maps JS SDK) 스크립트를 만들 때 화면이 필요로 하는 값만 내려준다.
      // 클라이언트 ID는 NCP 콘솔에서 도메인으로 제한하는 공개용 값이고, 시크릿은 여기서 절대 안 내려준다.
      const creds = readNaverCredentials(ENV_PATH);
      res.writeHead(200, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ naverMapClientId: creds ? creds.clientId : "" }));
      return;
    }

    if (req.method === "GET" && req.url.startsWith("/health")) {
      // 배포 환경변수가 실제로 서버 프로세스에 들어왔는지 값 노출 없이(있음/없음만) 확인하는 진단용 엔드포인트.
      // Render 무료 플랜은 Shell(printenv)이 막혀 있어, 이 엔드포인트로 대신 확인한다.
      let hasAnthropicApiKey = false;
      try {
        readApiKeyFromEnvFile(ENV_PATH);
        hasAnthropicApiKey = true;
      } catch {
        hasAnthropicApiKey = false;
      }
      res.writeHead(200, { "Content-Type": "application/json" });
      res.end(JSON.stringify({
        hasAnthropicApiKey,
        hasAnthropicWorkspaceId: Boolean(readWorkspaceId(ENV_PATH)),
        useLocalClaude: isLocalClaudeEnabled(ENV_PATH),
        hasNaverMapCreds: Boolean(readNaverCredentials(ENV_PATH)),
      }));
      return;
    }

    if (req.method === "GET" && req.url.startsWith("/api/geocode")) {
      // 화면 장소 검색(옛 Nominatim 직접 호출)을 대신하는 서버 프록시 — 시크릿이 브라우저로 나가지 않는다.
      // 네이버 Geocoding은 정확한 주소만 인식해 장소명(POI) 검색 결과가 0건인 경우가 많으므로,
      // 그럴 때만 무료 Nominatim으로 보강한다(네이버 결과가 있으면 그대로 우선 사용).
      try {
        const query = new URL(req.url, `http://localhost`).searchParams.get("q") || "";
        const creds = readNaverCredentials(ENV_PATH);
        let list = await naverGeocodeCandidates(creds, query);
        if (!list.length && query.trim()) list = await nominatimCandidates(query.trim());
        res.writeHead(200, { "Content-Type": "application/json" });
        res.end(JSON.stringify(list));
      } catch (error) {
        console.error("[orchestrator]", describeError(error));
        res.writeHead(500, { "Content-Type": "application/json" });
        res.end(JSON.stringify({ error: describeError(error) }));
      }
      return;
    }

    if (req.method === "POST" && req.url.startsWith("/parse-template")) {
      const MAX_UPLOAD_BYTES = 10 * 1024 * 1024; // 자사 양식 업로드 크기 제한: 10MB (초과 시 413)
      const contentLength = Number(req.headers["content-length"] || 0);
      if (contentLength > MAX_UPLOAD_BYTES) {
        res.writeHead(413, { "Content-Type": "application/json" });
        res.end(JSON.stringify({ error: "첨부 파일이 너무 큽니다 (최대 10MB)." }));
        return;
      }

      let body = "";
      let bytes = 0;
      let rejected = false;
      req.setEncoding("utf8");
      req.on("data", (chunk) => {
        if (rejected) return;
        bytes += Buffer.byteLength(chunk, "utf8");
        if (bytes > MAX_UPLOAD_BYTES) {
          rejected = true;
          res.writeHead(413, { "Content-Type": "application/json" });
          res.end(JSON.stringify({ error: "첨부 파일이 너무 큽니다 (최대 10MB)." }));
          req.destroy();
          return;
        }
        body += chunk;
      });
      req.on("end", async () => {
        if (rejected) return;
        try {
          const payload = JSON.parse(body);
          const apiKey = readApiKeyFromEnvFile(ENV_PATH);
          const client = createAnthropicClient(apiKey);
          console.log(`[orchestrator] 양식 분석 시작: ${payload.fileName || ""}`);
          const result = await parseTemplate(client, payload);
          console.log(`[orchestrator] 양식 분석 완료: 항목 ${result.fields.length}개 (confidence: ${result.confidence})`);
          res.writeHead(200, { "Content-Type": "application/json" });
          res.end(JSON.stringify(result));
        } catch (error) {
          console.error("[orchestrator]", describeError(error));
          res.writeHead(500, { "Content-Type": "application/json" });
          res.end(JSON.stringify({ error: describeError(error) }));
        }
      });
      return;
    }

    if (req.method !== "POST" || !req.url.startsWith("/run")) {
      res.writeHead(404, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ error: "POST /run, POST /parse-template, GET /config, GET /api/geocode 만 받습니다." }));
      return;
    }

    let body = "";
    req.setEncoding("utf8");
    req.on("data", (chunk) => (body += chunk));
    req.on("end", async () => {
      // NDJSON(줄바꿈으로 구분된 JSON) 스트림 — 화면이 각 단계 시작/종료를 실시간으로
      // 받아서, 포켓몬 애니메이션이 실제 에이전트가 일하는 카드 위에서 실제 속도로 움직이게 한다.
      res.writeHead(200, { "Content-Type": "application/x-ndjson" });
      try {
        const form = JSON.parse(body);
        console.log(`[orchestrator] 실행 시작: ${form.region || ""} / ${form.taskType || ""}`);
        const result = await runPipeline(form, (event) => {
          res.write(JSON.stringify(event) + "\n");
        });
        console.log(
          result.hardStopped
            ? `[orchestrator] ${result.hardStopped.stage} 단계에서 중단`
            : "[orchestrator] 5단계 모두 완료",
        );
        res.write(JSON.stringify({ type: "result", ...result }) + "\n");
        res.end();
      } catch (error) {
        console.error("[orchestrator]", describeError(error));
        res.write(JSON.stringify({ type: "error", error: describeError(error) }) + "\n");
        res.end();
      }
    });
  });

  server.listen(port, () => {
    console.log(`[orchestrator] http://localhost:${port}/run 에서 요청을 기다리고 있습니다.`);
  });
}

const aggregateFromIndex = process.argv.indexOf("--aggregate-from");
const serveIndex = process.argv.indexOf("--serve");

if (aggregateFromIndex !== -1) {
  // 디버깅용: 5단계를 다시 돌리지 않고, 캐시된 결과로 취합 단계만 재시도
  const cachePath = process.argv[aggregateFromIndex + 1] || STAGE_CACHE_PATH;
  const completed = JSON.parse(fs.readFileSync(cachePath, "utf8"));
  const apiKey = readApiKeyFromEnvFile(ENV_PATH);
  const client = createAnthropicClient(apiKey);
  aggregate(client, completed)
    .then((data) => console.log(JSON.stringify(data, null, 2)))
    .catch((error) => {
      console.error("[orchestrator]", describeError(error));
      process.exit(1);
    });
} else if (serveIndex !== -1) {
  // Render 등 배포 환경은 리슨할 포트를 PORT 환경변수로 지정한다 — 명령줄 인자보다 우선한다.
  const port = Number(process.env.PORT) || Number(process.argv[serveIndex + 1]) || 8788;
  runServer(port);
} else {
  console.error("사용법: node orchestrator/call-agent --serve [port]");
  process.exit(1);
}
